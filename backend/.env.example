# ==============================================================================
# CertiSure Backend Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO SOURCE CONTROL
# Copy this file to .env and configure your local credentials
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL=postgresql://postgres:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/certisure_db?schema=public

# Authentication & Cryptographic Tokens
# Generate random 32+ character secrets in production (e.g. via openssl rand -hex 32)
JWT_ACCESS_SECRET=certisure-dev-access-secret-minimum-32-characters-needed
JWT_REFRESH_SECRET=certisure-dev-refresh-secret-minimum-32-characters-needed
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Paths (Relative to backend directory or absolute)
STORAGE_PATH=./storage/certificates
STORAGE_TEMP_PATH=./storage/temp

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
